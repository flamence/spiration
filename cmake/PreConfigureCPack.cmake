if(APPLE)
    set(CPACK_GENERATOR "DragNDrop")
    set(CPACK_DMG_VOLUME_NAME "${PROJECT_NAME} ${PROJECT_VERSION}")
    set(CPACK_DMG_FORMAT "UDBZ")
elseif(WIN32)
    set(CPACK_GENERATOR "WIX")
    set(CPACK_WIX_VERSION 4)
    set(CPACK_WIX_PRODUCT_NAME "${SPIRATION_APP_NAME}")
    set(CPACK_WIX_INSTALL_SCOPE "perMachine")
    set(CPACK_WIX_UPGRADE_GUID "${SPIRATION_WIX_UPGRADE_GUID}")
    string(UUID CPACK_WIX_PRODUCT_GUID NAMESPACE ${CPACK_WIX_UPGRADE_GUID} NAME "${SPIRATION_APP_NAME}_Product_v${PROJECT_VERSION}" TYPE MD5)
    set(CPACK_WIX_PROGRAM_MENU_FOLDER "${SPIRATION_APP_NAME}")
    set(CPACK_WIX_CULTURES "zh-CN;en-US")
    set(CPACK_WIX_LICENSE_RTF "${CMAKE_CURRENT_SOURCE_DIR}/cpack/license.rtf")
elseif(UNIX)
    set(CPACK_GENERATOR "DEB")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CPACK_PACKAGE_CONTACT}")
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Spiration")
endif()
set(CPACK_PACKAGE_NAME "${SPIRATION_APP_NAME}")
set(CPACK_PACKAGE_CONTACT "${SPIRATION_VENDOR}")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/pkg")
string(TOLOWER "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}" ARCH_SUFFIX)
set(CPACK_PACKAGE_FILE_NAME "${PROJECT_NAME}-v${PROJECT_VERSION}-${ARCH_SUFFIX}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "${SPIRATION_APP_NAME}")
set(CPACK_PACKAGE_VENDOR "${SPIRATION_VENDOR}")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE")
if(NOT APPLE AND NOT __OHOS__)
if(NOT WIN32)
    set(SPIRATION_INSTALL_RESOURCES "share/${PROJECT_NAME}")
else()
    set(SPIRATION_INSTALL_RESOURCES "share")
endif()
endif()
